[Unit]
Description=Sandroid MRCP bridge (UniMRCP plugin <-> Python ASR)
After=network.target
Before=unimrcp.service

[Service]
Type=simple
# Runtime socket dir (/var/run is tmpfs; recreate on boot)
RuntimeDirectory=sandroid
RuntimeDirectoryMode=0755
Environment=PYTHONPATH=/opt/sandroid/src
Environment=SANDROID_BRIDGE_SOCK=/var/run/sandroid/bridge.sock
Environment=SANDROID_BRIDGE_LOG=INFO
# Paraformer ASR artifacts live under /opt/sandroid/deploy/models/ — override
# deps.py's default (which resolves relative to the source tree and would fail
# under the /opt/sandroid layout). SANDROID_ENV=dev for first boot so missing
# artifacts fall back to StubASR instead of crash-looping; flip to production
# once the journalctl log confirms "ASR backend=ParaformerASR".
Environment=SANDROID_ENV=dev
Environment=SANDROID_ASR_BACKEND=paraformer
Environment=SANDROID_ASR_MODEL_PATH=/opt/sandroid/deploy/models/paraformer_zh.int8.onnx
Environment=SANDROID_ASR_TOKENS_PATH=/opt/sandroid/deploy/models/paraformer_zh.tokens.txt
Environment=SANDROID_ASR_CMVN_PATH=/opt/sandroid/deploy/models/paraformer_zh.am.mvn
# NLU matcher: same override pattern as ASR. The bridge reads SANDROID_
# BRIDGE_DEFAULT_SCENE to decide which scene to route the transcript into;
# leave unset to disable NLU and keep emitting PLACEHOLDER_INTENT.
Environment=SANDROID_SCENES_DIR=/opt/sandroid/configs/scenes
Environment=SANDROID_NLU_BACKEND=embedder
Environment=SANDROID_NLU_MODEL_PATH=/opt/sandroid/deploy/models/nlu_embedder_quantized.onnx
Environment=SANDROID_NLU_TOKENIZER_PATH=/opt/sandroid/deploy/models/nlu_tokenizer.json
Environment=SANDROID_SILERO_PATH=/opt/sandroid/deploy/models/silero_vad.onnx
Environment=SANDROID_BRIDGE_DEFAULT_SCENE=example_bank
ExecStart=/usr/bin/python3 -m sandroid.adapters.mrcp.bridge
Restart=on-failure
RestartSec=2
# stdin must be /dev/null so nothing is mistaken for server commands
StandardInput=null
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
